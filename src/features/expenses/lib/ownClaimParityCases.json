{
  "_comment": "Shared by the client (claimMath.ts claimAmountMinor) and the server (set_my_receipt_claims, supabase/tests/pglite/parts/95_phase4.mjs). A case: one line {quantity, total}, the OTHER people's rows [[quantity_claimed, amount_owed], ...] and the quantity the caller claims; expectMinor = what the caller owes in minor units of the currency. Rule: the caller's share of the line total at the unit price, rounded half away from zero; a claim that takes the last of the line (quantity left < 0.001) takes exactly what the others left (never below 0).",
  "cases": [
    { "name": "one of three beers", "currency": "EUR", "line": { "quantity": 3, "total": 30 }, "others": [], "quantity": 1, "expectMinor": 1000 },
    { "name": "two of three beers", "currency": "EUR", "line": { "quantity": 3, "total": 30 }, "others": [], "quantity": 2, "expectMinor": 2000 },
    { "name": "all three beers", "currency": "EUR", "line": { "quantity": 3, "total": 30 }, "others": [], "quantity": 3, "expectMinor": 3000 },
    { "name": "last third takes what the others left (3.34)", "currency": "EUR", "line": { "quantity": 3, "total": 10 }, "others": [[1, 3.33], [1, 3.33]], "quantity": 1, "expectMinor": 334 },
    { "name": "middle third is plain rounding (3.33)", "currency": "EUR", "line": { "quantity": 3, "total": 10 }, "others": [[1, 3.34]], "quantity": 1, "expectMinor": 333 },
    { "name": "half a penny rounds away from zero", "currency": "EUR", "line": { "quantity": 2, "total": 0.05 }, "others": [], "quantity": 1, "expectMinor": 3 },
    { "name": "unit price with a long tail", "currency": "EUR", "line": { "quantity": 3, "total": 10.01 }, "others": [], "quantity": 1, "expectMinor": 334 },
    { "name": "JPY has no minor unit", "currency": "JPY", "line": { "quantity": 3, "total": 1000 }, "others": [], "quantity": 1, "expectMinor": 333 },
    { "name": "JPY last third", "currency": "JPY", "line": { "quantity": 3, "total": 1000 }, "others": [[1, 333], [1, 333]], "quantity": 1, "expectMinor": 334 },
    { "name": "single unit line", "currency": "GBP", "line": { "quantity": 1, "total": 12.5 }, "others": [], "quantity": 1, "expectMinor": 1250 },
    { "name": "others overpaid the line: floor at zero", "currency": "EUR", "line": { "quantity": 2, "total": 10 }, "others": [[1, 10.5]], "quantity": 1, "expectMinor": 0 },
    { "name": "zero-total line", "currency": "EUR", "line": { "quantity": 2, "total": 0 }, "others": [], "quantity": 1, "expectMinor": 0 },
    { "name": "hundredths of a unit", "currency": "EUR", "line": { "quantity": 4, "total": 20 }, "others": [], "quantity": 0.5, "expectMinor": 250 },
    { "name": "taking the last 0.5 after a legacy half", "currency": "EUR", "line": { "quantity": 1, "total": 9.99 }, "others": [[0.5, 5]], "quantity": 0.5, "expectMinor": 499 }
  ]
}
